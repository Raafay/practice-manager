# Copy to .env for local development. Never commit .env.
# For a quick look without PostgreSQL: DATABASE_URL=sqlite:///local.sqlite3
DATABASE_URL=postgres://pm:pm@localhost:5432/pm_dev
SECRET_KEY=django-insecure-change-me-for-local-use
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated Fernet keys, newest first. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in development to derive one from SECRET_KEY.
FIELD_ENCRYPTION_KEYS=
# Code that passes two-factor for seeded users. Development only.
MFA_TOTP_INSECURE_BYPASS_CODE=000000
DEFAULT_FROM_EMAIL=Practice Manager <no-reply@example.com>
# Companies House REST API key (free, from developer.company-information.service.gov.uk).
# Leave empty to run without it: lookups then fail with "refused the API key".
COMPANIES_HOUSE_API_KEY=
# "fake" serves the made-up samples in apps/companieshouse/tests/samples instead.
COMPANIES_HOUSE_TRANSPORT=live

# Production variables are listed in docs/DEPLOY.md, section 5.
